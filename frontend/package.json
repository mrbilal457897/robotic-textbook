{
  "name": "rag-textbook-chatbot-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend for RAG-powered textbook chatbot",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "vitest",
