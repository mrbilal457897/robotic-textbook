# ============================================
# Railway Environment Variables Template
# Copy these to Railway Dashboard → Variables
# ============================================

# ============================================
# App Configuration (Railway Auto-Provides PORT)
# ============================================
APP_HOST=0.0.0.0
APP_PORT=$PORT
APP_ENV=production
APP_DEBUG=false
APP_NAME=rag-textbook-chatbot
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# CORS Configuration (ADD YOUR VERCEL URL)
# ============================================
CORS_ORIGINS=https://your-vercel-app.vercel.app,https://your-custom-domain.com

# ============================================
# AI API Keys (REQUIRED - Get from your dashboards)
# ============================================
# Cohere API (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_EMBEDDING_INPUT_TYPE=search_document

# Google Gemini API (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.7

# ============================================
# Database Configuration (Railway Auto-Provides)
# ============================================
# PostgreSQL (Railway will inject these automatically when you add PostgreSQL service)
POSTGRES_HOST=${{Postgres.PGHOST}}
POSTGRES_PORT=${{Postgres.PGPORT}}
POSTGRES_USER=${{Postgres.PGUSER}}
POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}
POSTGRES_DB=${{Postgres.PGDATABASE}}
# Or use DATABASE_URL directly
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ============================================
# Vector Database - Qdrant (Railway Service)
# ============================================
# Option 1: Deploy Qdrant on Railway (Docker)
QDRANT_URL=http://qdrant.railway.internal:6333
QDRANT_API_KEY=  # Optional, leave empty if not using auth

# Option 2: Use Qdrant Cloud (Recommended)
# QDRANT_URL=https://your-cluster.qdrant.cloud
# QDRANT_API_KEY=your_qdrant_cloud_api_key

QDRANT_COLLECTION_NAME=textbook_chunks
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine

# ============================================
# Redis Configuration (Railway Auto-Provides)
# ============================================
# Railway will inject these when you add Redis service
REDIS_HOST=${{Redis.REDIS_HOST}}
REDIS_PORT=${{Redis.REDIS_PORT}}
REDIS_PASSWORD=${{Redis.REDIS_PASSWORD}}
# Or use REDIS_URL directly
REDIS_URL=${{Redis.REDIS_URL}}

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ANONYMOUS=50
RATE_LIMIT_AUTHENTICATED=200
RATE_LIMIT_WINDOW_MINUTES=60

# ============================================
# Authentication (Optional - GitHub OAuth)
# ============================================
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_REDIRECT_URI=https://your-railway-app.up.railway.app/api/v1/auth/github/callback

# JWT Configuration
JWT_SECRET_KEY=generate_random_secret_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Session Configuration
SESSION_SECRET_KEY=generate_another_random_secret_key_here_minimum_32_characters
SESSION_COOKIE_NAME=session_id
SESSION_MAX_AGE=86400

# ============================================
# Security & Monitoring (Optional)
# ============================================
# Sentry Error Tracking (https://sentry.io)
SENTRY_DSN=  # Optional

# Feature Flags
ENABLE_GENERAL_KNOWLEDGE_MODE=true
ENABLE_TONE_CONTROL=true
ENABLE_CITATION_VALIDATION=true

# ============================================
# IMPORTANT NOTES FOR RAILWAY DEPLOYMENT
# ============================================
# 1. Replace all "your_*_here" placeholders with actual values
# 2. $PORT is automatically provided by Railway (DO NOT CHANGE)
# 3. ${{Service.VARIABLE}} syntax connects to Railway services
# 4. Generate secure random keys for JWT and SESSION secrets
# 5. Update CORS_ORIGINS with your actual Vercel URL
# 6. Never commit .env files with real secrets to Git
